    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n\n// ─────────────────────────────────────────────────────────────\n// Helper: Parse comma-separated categories string into array\n// ─────────────────────────────────────────────────────────────\nfunction toCategoryArray(categoriesStr) {\n    if (!categoriesStr || typeof categoriesStr !== 'string') return [];\n    \n    return categoriesStr\n        .split(',')\n        .map(s => s.trim())\n        .filter(Boolean);\n}\n\n\n// ─────────────────────────────────────────────────────────────\n// Helper: Parse \" | \" separated attributes into structured array\n// Input:  \"Width: 50 | Material: Steel\"\n// Output: [{ name: 'Width', value: '50' }, { name: 'Material', value: 'Steel' }]\n// ─────────────────────────────────────────────────────────────\nfunction toAttributesArray(attributesStr) {\n    if (!attributesStr || typeof attributesStr !== 'string') return [];\n    \n    return attributesStr\n        .split(' | ')\n        .map(s => s.trim())\n        .filter(Boolean)\n        .map(pair => {\n            const idx = pair.indexOf(':');\n            if (idx === -1) return { name: pair, value: '' };\n            return {\n                name:  pair.slice(0, idx).trim(),\n                // FIX: strip leading \": \" from value to avoid double-colon\n                // OpenCart sometimes sends \"Колеса: : немає\" where value starts with \": \"\n                value: pair.slice(idx + 1).trim().replace(/^:\\s*/, ''),\n            };\n        });\n}\n\n\n// ─────────────────────────────────────────────────────────────\n// Main: Transform each product for Supabase\n// ─────────────────────────────────────────────────────────────\nreturn $input.all().map((item) => {\n    const p = item.json;\n    \n    const categories = toCategoryArray(p.categories);\n    const attributes = toAttributesArray(p.attributes);\n    \n    \n    // Build the embedding document (keep it stable and consistent)\n    const contentParts = [\n        p.model        ? `${p.model}`               : null,\n        p.sku          ? `${p.sku}`                   : null,\n        p.name         ? `${p.name}`                 : null,\n        p.manufacturer ? `${p.manufacturer}` : null,\n        \n        categories.length \n            ? `${categories.join(', ')}` \n            : null,\n        \n        attributes.length \n            ? `${attributes.map(a => `${a.name}: ${a.value}`).join(' | ')}` \n            : null,\n        \n        p.description_clean \n            ? `${p.description_clean}` \n            : null,\n    ].filter(Boolean);\n    \n    \n    const content = contentParts.join('\\n');\n    \n    const content_hash = crypto\n        .createHash('sha256')\n        .update(content, 'utf8')\n        .digest('hex');\n    \n    \n    return {\n        json: {\n            ...p,\n            \n            // Convert for JSONB columns\n            categories,\n            attributes,\n            content,\n            content_hash,\n            \n            // Ensure numerics are actual numbers (helps Supabase)\n            price:         p.price         == null ? null : Number(p.price),\n            special_price: p.special_price == null ? null : Number(p.special_price),\n            quantity:      p.quantity      == null ? null : Number(p.quantity),\n        }\n    };\n});"
      },
