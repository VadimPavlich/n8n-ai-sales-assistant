{
  "name": "OpenCart → Supabase (Products + Embeddings) + Chatbot RAG (hash + loop)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "function decodeHtml(s) {\n  if (!s) return '';\n  return s\n    // Original 7 entities\n    .replaceAll('&nbsp;', ' ')\n    .replaceAll('&lt;', '<')\n    .replaceAll('&gt;', '>')\n    .replaceAll('&amp;', '&')\n    .replaceAll('&quot;', '\"')\n    .replaceAll('&#039;', \"'\")\n    .replaceAll('&apos;', \"'\")\n    // Punctuation & typography\n    .replaceAll('&bull;', '\\n• ')\n    .replaceAll('&mdash;', '—')\n    .replaceAll('&ndash;', '–')\n    .replaceAll('&laquo;', '«')\n    .replaceAll('&raquo;', '»')\n    .replaceAll('&lsquo;', \"'\")\n    .replaceAll('&rsquo;', \"'\")\n    // Symbols & special chars\n    .replaceAll('&deg;', '°')\n    .replaceAll('&trade;', '™')\n    .replaceAll('&reg;', '®')\n    .replaceAll('&plusmn;', '±')\n    .replaceAll('&times;', '×')\n    .replaceAll('&Oslash;', 'Ø')\n    .replaceAll('&sup2;', '²')\n    .replaceAll('&Prime;', '″')\n    // Accented characters\n    .replaceAll('&oacute;', 'ó')\n    .replaceAll('&Uuml;', 'Ü')\n    // Math\n    .replaceAll('&le;', '≤');\n}\n\nfunction stripTags(s) {\n  if (!s) return '';\n  return s.replace(/<[^>]*>/g, ' ');\n}\n\nfunction fixProductUrl(url) {\n  if (!url) return '';\n  return url.replace('shop.example.com/', 'shop.example.com/ua/');\n}\n\nreturn $input.all().map((item) => {\n  const base = item.json && typeof item.json === 'object' ? item.json : {};\n  \n  // Clean description\n  const decoded = decodeHtml(base.description || '');\n  const clean = stripTags(decoded).replace(/\\s+/g, ' ').trim();\n  \n  // Fix product URL\n  const fixedUrl = fixProductUrl(base.product_url || '');\n  \n  // Remove old fields to avoid confusion\n  const { description, product_url, ...rest } = base;\n  \n  return {\n    json: {\n      ...rest,\n      description_clean: clean,\n      product_url: fixedUrl\n    }\n  };\n});"
      },
      "id": "b82ecce7-c179-438d-a258-24bf7a4f0038",
      "name": "Code - Clean HTML + Build content/metadata",
      "type": "n8n-nodes-base.code",
      "position": [
        512,
        320
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    p.product_id,\n    pd.name,\n    pd.description,\n    p.price,\n    sp.special_price,\n    p.model,\n    p.sku,\n    p.quantity,\n    p.subtract,\n    p.date_available,\n    p.status,\n    m.name                          AS manufacturer,\n    COALESCE(cat.category_name, '') AS categories,\n    COALESCE(attr.attributes, '')   AS attributes,\n\n    CASE\n        WHEN p.status = 0 THEN 'DISABLED'\n        WHEN p.date_available > NOW() THEN 'NOT_YET_AVAILABLE'\n        WHEN p.subtract = 1 AND p.quantity <= 0 THEN 'OUT_OF_STOCK'\n        WHEN p.subtract = 0 THEN 'IN_STOCK_UNLIMITED'\n        ELSE 'IN_STOCK'\n    END AS availability_status,\n\n    CASE\n        WHEN p.status = 1\n         AND p.date_available <= NOW()\n         AND (p.subtract = 0 OR p.quantity > 0)\n        THEN 1 ELSE 0\n    END AS is_sellable,\n\n    CONCAT(\n        'https://shop.example.com/', \n        COALESCE(\n            ua.keyword, \n            CONCAT('index.php?route=product/product&product_id=', p.product_id)\n        )\n    )                               AS product_url\n\nFROM oc_product p\n\n-- Product description (Ukrainian)\nJOIN oc_product_description pd\n    ON  pd.product_id = p.product_id\n    AND pd.language_id = 3\n\n-- SEO URL alias\nLEFT JOIN oc_url_alias ua\n    ON ua.query = CONCAT('product_id=', p.product_id)\n\n-- Manufacturer / Brand\nLEFT JOIN oc_manufacturer m\n    ON m.manufacturer_id = p.manufacturer_id\n\n-- Category (deepest/leaf only)\nLEFT JOIN (\n    SELECT \n        pc.product_id,\n        cd.name AS category_name\n    FROM oc_product_to_category pc\n    JOIN oc_category_description cd\n        ON  cd.category_id = pc.category_id\n        AND cd.language_id = 3\n    JOIN oc_category_path cp\n        ON  cp.category_id = pc.category_id\n    INNER JOIN (\n        SELECT \n            pc2.product_id,\n            MAX(cp2.level) AS max_level\n        FROM oc_product_to_category pc2\n        JOIN oc_category_path cp2\n            ON cp2.category_id = pc2.category_id\n        GROUP BY pc2.product_id\n    ) deepest\n        ON  deepest.product_id = pc.product_id\n        AND cp.level = deepest.max_level\n    GROUP BY pc.product_id\n) cat \n    ON cat.product_id = p.product_id\n\n-- Attributes (aggregated)\nLEFT JOIN (\n    SELECT \n        pa.product_id,\n        GROUP_CONCAT(\n            DISTINCT CONCAT(ad.name, ': ', pa.text) \n            SEPARATOR ' | '\n        ) AS attributes\n    FROM oc_product_attribute pa\n    JOIN oc_attribute_description ad\n        ON  ad.attribute_id = pa.attribute_id\n        AND ad.language_id = 3\n    WHERE pa.language_id = 3\n    GROUP BY pa.product_id\n) attr \n    ON attr.product_id = p.product_id\n\n-- Special price (lowest active)\nLEFT JOIN (\n    SELECT \n        product_id, \n        MIN(price) AS special_price\n    FROM oc_product_special\n    GROUP BY product_id\n) sp \n    ON sp.product_id = p.product_id\n\nWHERE p.status = 1\n  AND p.product_id > {{ $json.last_id }}\n\nORDER BY p.product_id\nLIMIT 100;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        112,
        320
      ],
      "id": "e03a697f-e626-496e-913e-c8e4b06bfd23",
