    {
      "parameters": {
        "jsCode": "// ==========================================\n// VALIDATE & FORMAT CONTACT DATA v3\n// Name/email only — phone goes to Create-CRM-Order\n// ==========================================\nconst input = $input.first().json;\nconst sessionId = input.session_id || '';\nconst rawName = (input.customer_name || '').trim();\nconst rawEmail = (input.email || '').trim();\n\nif (!sessionId) {\n  return { success: false, response_to_ai: 'Помилка: session_id відсутній.' };\n}\n\nif (!rawName && !rawEmail) {\n  return { success: false, response_to_ai: 'Потрібно хоча б ім\\'я або email.' };\n}\n\n// --- Format name (if provided) ---\nlet name = null;\nif (rawName && rawName.length >= 2) {\n  name = rawName.split(' ')\n    .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())\n    .join(' ');\n}\n\nreturn {\n  sessionId,\n  name,\n  email: rawEmail || null,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        304
      ],
      "id": "d6c4efe6-bf10-49ba-8f82-9913b93b0541",
      "name": "Validate & Format"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://YOUR_PROJECT.supabase.co/rest/v1/rpc/upsert_chat_lead",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_session_id\": \"{{ $json.sessionId }}\",\n  \"p_name\": {{ $json.name ? '\"' + $json.name + '\"' : 'null' }},\n  \"p_phone\": null,\n  \"p_email\": {{ $json.email ? '\"' + $json.email + '\"' : 'null' }},\n  \"p_first_product_id\": null,\n  \"p_first_product_name\": null,\n  \"p_first_product_price\": null,\n  \"p_first_product_url\": null\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
