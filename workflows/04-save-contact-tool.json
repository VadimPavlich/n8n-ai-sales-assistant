    {
      "parameters": {
        "content": "## Save Contact (Tool Workflow)\n\nCalled by AI Agent when customer provides name + phone.\nSaves to Supabase and creates SalesDrive lead if new.\n\n**Inputs from AI:**\n- session_id (auto-passed)\n- customer_name, phone_number\n- email (optional)\n\n**Replaces:** Information Extractor + entire CRM branch in main workflow",
        "height": 312,
        "width": 360,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -144
      ],
      "id": "499c1018-2709-4690-bc6f-2fa82252c630",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "const contact = $('Validate & Format').first().json;\nconst upsertResult = $input.first().json;\nconst lead = Array.isArray(upsertResult) ? upsertResult[0] : upsertResult;\n\nconst parts = [];\nif (contact.name) parts.push(contact.name);\nif (contact.phone) parts.push(contact.phone);\n\n// Guard against empty saves\nif (parts.length === 0) {\n  return {\n    success: false,\n    response_to_ai: 'Не вдалося зберегти — немає валідних даних.',\n  };\n}\n\nreturn {\n  success: true,\n  sessionId: contact.sessionId,\n  leadId: lead?.lead_id || null,\n  response_to_ai: `Контакт збережено: ${parts.join(', ')}.`,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
